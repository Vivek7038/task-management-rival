# Neon pooled connection string (used at runtime by Prisma)
DATABASE_URL="postgresql://user:password@ep-xxx.neon.tech/dbname?sslmode=require&pgbouncer=true"

# Neon direct connection string (used by Prisma Migrate)
DIRECT_URL="postgresql://user:password@ep-xxx.neon.tech/dbname?sslmode=require"

# JWT signing secret - generate with: openssl rand -base64 32
JWT_SECRET="your-strong-secret-here"

# Vercel Blob read/write token
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Public app URL (no trailing slash)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
